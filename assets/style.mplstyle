# One plotting style for every figure in this repository.
# Solid off-white surface so PNGs read on light and dark pages; recessive grid and axes.

figure.facecolor: fcfcfb
figure.dpi: 150
savefig.dpi: 150
savefig.facecolor: fcfcfb
savefig.bbox: tight
savefig.pad_inches: 0.08

axes.facecolor: fcfcfb
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.labelcolor: 0b0b0b
axes.labelsize: 9
axes.titlesize: 9.5
axes.titleweight: bold
axes.titlecolor: 0b0b0b
axes.titlelocation: left
axes.titlepad: 6
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])

grid.color: e1e0d9
grid.linewidth: 0.6

xtick.color: 898781
ytick.color: 898781
xtick.labelcolor: 52514e
ytick.labelcolor: 52514e
xtick.labelsize: 8
ytick.labelsize: 8
xtick.direction: out
ytick.direction: out

lines.linewidth: 1.5
lines.markersize: 6

legend.frameon: False
legend.fontsize: 8
legend.labelcolor: 52514e

font.family: sans-serif
font.sans-serif: Segoe UI, DejaVu Sans, Arial, sans-serif
font.size: 9
text.color: 0b0b0b

image.interpolation: nearest
image.origin: lower
